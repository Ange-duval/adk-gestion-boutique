<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Numérotation -->
    <record id="seq_adk_shop_expense" model="ir.sequence">
        <field name="name">Dépense de boutique</field>
        <field name="code">adk.shop.expense</field>
        <field name="prefix">DEP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_adk_shop_transfer" model="ir.sequence">
        <field name="name">Transfert interboutiques</field>
        <field name="code">adk.shop.transfer</field>
        <field name="prefix">TRF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_adk_shop_income" model="ir.sequence">
        <field name="name">Autre revenu de boutique</field>
        <field name="code">adk.shop.income</field>
        <field name="prefix">REV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_adk_shop_cash_move" model="ir.sequence">
        <field name="name">Mouvement de caisse</field>
        <field name="code">adk.shop.cash.move</field>
        <field name="prefix">CAI/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_adk_shop_session" model="ir.sequence">
        <field name="name">Journée de caisse</field>
        <field name="code">adk.shop.session</field>
        <field name="prefix">JC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="partner_walkin" model="res.partner">
        <field name="name">Client de passage</field>
        <field name="company_id" eval="False"/>
        <field name="comment">Client par défaut des ventes comptoir de la caisse (vente POS).</field>
    </record>

    <!-- Les catégories de revenus et de dépenses usuelles sont créées par hooks.py (post_init_hook) :
         création idempotente, sans conflit si une catégorie du même nom existe déjà dans la base. -->

    <!-- Centre d'alertes : génération quotidienne -->
    <record id="cron_adk_generate_alerts" model="ir.cron">
        <field name="name">ADK : générer les alertes des boutiques</field>
        <field name="model_id" ref="model_adk_shop_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_alerts()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
