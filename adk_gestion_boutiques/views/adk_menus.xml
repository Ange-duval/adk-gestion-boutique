<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_adk_customers" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('adk_shop_ids', '!=', False), ('customer_rank', '>', 0)]</field>
        <field name="context">{'default_customer_rank': 1}</field>
    </record>
    <record id="action_adk_suppliers" model="ir.actions.act_window">
        <field name="name">Fournisseurs</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('adk_shop_ids', '!=', False), ('supplier_rank', '>', 0)]</field>
        <field name="context">{'default_supplier_rank': 1}</field>
    </record>
    <record id="action_adk_products" model="ir.actions.act_window">
        <field name="name">Catalogue des boutiques</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('adk_shop_ids', '!=', False)]</field>
    </record>
    <record id="action_adk_sale_orders" model="ir.actions.act_window">
        <field name="name">Commandes de vente</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('adk_shop_id', '!=', False)]</field>
        <field name="context">{'search_default_adk_group_shop': 1}</field>
    </record>
    <record id="action_adk_customer_invoices" model="ir.actions.act_window">
        <field name="name">Factures clients</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('adk_shop_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_adk_group_shop': 1}</field>
    </record>
    <record id="action_adk_purchase_orders" model="ir.actions.act_window">
        <field name="name">Commandes d'achat</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('adk_shop_id', '!=', False)]</field>
        <field name="context">{'search_default_adk_group_shop': 1}</field>
    </record>
    <record id="action_adk_vendor_bills" model="ir.actions.act_window">
        <field name="name">Factures fournisseurs</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('adk_shop_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_adk_group_shop': 1}</field>
    </record>

    <record id="action_adk_payments_in" model="ir.actions.act_window">
        <field name="name">Encaissements</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('adk_shop_id', '!=', False), ('payment_type', '=', 'inbound')]</field>
        <field name="context">{'default_payment_type': 'inbound'}</field>
    </record>
    <record id="action_adk_payments_out" model="ir.actions.act_window">
        <field name="name">Paiements fournisseurs</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('adk_shop_id', '!=', False), ('payment_type', '=', 'outbound')]</field>
        <field name="context">{'default_payment_type': 'outbound'}</field>
    </record>

    <menuitem id="menu_adk_root" name="ADK Gestion Boutiques" sequence="30"
              web_icon="adk_gestion_boutiques,static/description/icon.png" groups="group_adk_user"/>

    <menuitem id="menu_adk_dashboard" name="Tableau de bord" parent="menu_adk_root" action="action_adk_dashboard_client" sequence="5"/>

    <menuitem id="menu_adk_network" name="Réseau de boutiques" parent="menu_adk_root" sequence="10"/>
    <menuitem id="menu_adk_shops" name="Boutiques" parent="menu_adk_network" action="action_adk_shop" sequence="10"/>
    <menuitem id="menu_adk_groups" name="Groupes" parent="menu_adk_network" action="action_adk_shop_group" sequence="20"/>
    <menuitem id="menu_adk_cards" name="Boutiques (cartes)" parent="menu_adk_network" action="action_adk_dashboard" sequence="5"/>
    <menuitem id="menu_adk_alerts" name="Centre d'alertes" parent="menu_adk_network" action="action_adk_alert" sequence="30"/>

    <menuitem id="menu_adk_revenue" name="Revenus" parent="menu_adk_root" sequence="20"/>
    <menuitem id="menu_adk_sales" name="Commandes de vente" parent="menu_adk_revenue" action="action_adk_sale_orders" sequence="10"/>
    <menuitem id="menu_adk_invoices" name="Factures clients" parent="menu_adk_revenue" action="action_adk_customer_invoices" sequence="20"/>
    <menuitem id="menu_adk_payments_in" name="Encaissements" parent="menu_adk_revenue" action="action_adk_payments_in" sequence="25"/>
    <menuitem id="menu_adk_incomes" name="Autres revenus" parent="menu_adk_revenue" action="action_adk_income" sequence="27"/>
    <menuitem id="menu_adk_customers" name="Clients" parent="menu_adk_revenue" action="action_adk_customers" sequence="30"/>
    <menuitem id="menu_adk_sales_analysis" name="Analyse des ventes" parent="menu_adk_revenue" action="action_adk_sales_analysis" sequence="40"/>

    <menuitem id="menu_adk_charges" name="Charges" parent="menu_adk_root" sequence="30"/>
    <menuitem id="menu_adk_purchases" name="Commandes d'achat" parent="menu_adk_charges" action="action_adk_purchase_orders" sequence="10"/>
    <menuitem id="menu_adk_bills" name="Factures fournisseurs" parent="menu_adk_charges" action="action_adk_vendor_bills" sequence="20"/>
    <menuitem id="menu_adk_payments_out" name="Paiements fournisseurs" parent="menu_adk_charges" action="action_adk_payments_out" sequence="25"/>
    <menuitem id="menu_adk_expenses" name="Dépenses" parent="menu_adk_charges" action="action_adk_expense" sequence="30"/>
    <menuitem id="menu_adk_suppliers" name="Fournisseurs" parent="menu_adk_charges" action="action_adk_suppliers" sequence="40"/>
    <menuitem id="menu_adk_budgets" name="Budgets" parent="menu_adk_charges" action="action_adk_budget" sequence="50"/>
    <menuitem id="menu_adk_charges_analysis" name="Analyse des achats" parent="menu_adk_charges" action="action_adk_charges_analysis" sequence="60"/>

    <menuitem id="menu_adk_stock" name="Produits et stocks" parent="menu_adk_root" sequence="40"/>
    <menuitem id="menu_adk_catalog" name="Catalogue" parent="menu_adk_stock" action="action_adk_products" sequence="10"/>
    <menuitem id="menu_adk_quants" name="Stock par boutique" parent="menu_adk_stock" action="action_adk_stock_quants" sequence="20"/>
    <menuitem id="menu_adk_moves" name="Mouvements" parent="menu_adk_stock" action="action_adk_stock_moves" sequence="30"/>
    <menuitem id="menu_adk_transfers" name="Transferts interboutiques" parent="menu_adk_stock" action="action_adk_transfer" sequence="40"/>

    <menuitem id="menu_adk_cash" name="Caisse" parent="menu_adk_root" sequence="45"/>
    <menuitem id="menu_adk_sessions" name="Journées de caisse" parent="menu_adk_cash" action="action_adk_session" sequence="5"/>
    <menuitem id="menu_adk_cash_moves" name="Mouvements de caisse" parent="menu_adk_cash" action="action_adk_cash_move" sequence="10"/>

    <menuitem id="menu_adk_reports" name="Analyses et rapports" parent="menu_adk_root" sequence="50"/>
    <menuitem id="menu_adk_report_wizard" name="Rapports imprimables" parent="menu_adk_reports" action="action_adk_report_wizard" sequence="10"/>
    <menuitem id="menu_adk_expense_analysis" name="Analyse des dépenses" parent="menu_adk_reports" action="action_adk_expense" sequence="20"/>

    <menuitem id="menu_adk_config" name="Configuration" parent="menu_adk_root" sequence="90" groups="group_adk_manager"/>
    <menuitem id="menu_adk_expense_categories" name="Catégories de dépenses" parent="menu_adk_config" action="action_adk_expense_category" sequence="10"/>
    <menuitem id="menu_adk_income_categories" name="Catégories d'autres revenus" parent="menu_adk_config" action="action_adk_income_category" sequence="20"/>
</odoo>
