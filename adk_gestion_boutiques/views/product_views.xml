<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_adk" model="ir.ui.view">
        <field name="name">product.template.form.adk</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Boutiques ADK" name="adk_shops">
                    <group>
                        <field name="adk_shop_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_adk" model="ir.ui.view">
        <field name="name">product.template.search.adk</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="adk_shop_ids"/>
            </xpath>
        </field>
    </record>
</odoo>
