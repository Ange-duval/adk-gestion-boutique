<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adk_transfer_list" model="ir.ui.view">
        <field name="name">adk.shop.transfer.list</field>
        <field name="model">adk.shop.transfer</field>
        <field name="arch" type="xml">
            <list string="Transferts interboutiques">
                <field name="name"/>
                <field name="date_request"/>
                <field name="shop_from_id"/>
                <field name="shop_to_id"/>
                <field name="state" widget="badge" decoration-info="state in ('requested', 'approved')"
                       decoration-warning="state == 'shipped'" decoration-success="state == 'received'"/>
            </list>
        </field>
    </record>

    <record id="view_adk_transfer_form" model="ir.ui.view">
        <field name="name">adk.shop.transfer.form</field>
        <field name="model">adk.shop.transfer</field>
        <field name="arch" type="xml">
            <form string="Transfert interboutiques">
                <header>
                    <button name="action_request" string="Envoyer la demande" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Valider" type="object" class="btn-primary" invisible="state != 'requested'"
                            groups="adk_gestion_boutiques.group_adk_manager"/>
                    <button name="action_ship" string="Expédier" type="object" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_receive" string="Confirmer la réception" type="object" class="btn-primary" invisible="state != 'shipped'"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state in ('shipped', 'received', 'cancelled')"/>
                    <button name="action_draft" string="Remettre en brouillon" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,requested,approved,shipped,received"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="shop_from_id" readonly="state != 'draft'"/>
                            <field name="shop_to_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_request"/>
                            <field name="date_expected"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Produits" name="lines">
                            <field name="line_ids" readonly="state not in ('draft', 'requested')">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="available_qty" readonly="1"/>
                                    <field name="qty_requested"/>
                                    <field name="qty_sent" readonly="1"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Mouvements de stock" name="pickings">
                            <group>
                                <field name="out_picking_id"/>
                                <field name="in_picking_id"/>
                            </group>
                        </page>
                        <page string="Notes" name="note"><field name="note"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_adk_transfer" model="ir.actions.act_window">
        <field name="name">Transferts interboutiques</field>
        <field name="res_model">adk.shop.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Demandez du stock à une autre boutique</p>
            <p>Demande, validation, expédition, réception : chaque étape génère de vrais mouvements de stock Odoo.</p>
        </field>
    </record>

    <!-- Alertes -->
    <record id="view_adk_alert_list" model="ir.ui.view">
        <field name="name">adk.shop.alert.list</field>
        <field name="model">adk.shop.alert</field>
        <field name="arch" type="xml">
            <list string="Alertes" decoration-danger="severity == '2' and state != 'resolved'"
                  decoration-warning="severity == '1' and state != 'resolved'" decoration-muted="state == 'resolved'">
                <field name="date"/>
                <field name="shop_id"/>
                <field name="alert_type"/>
                <field name="name"/>
                <field name="severity" widget="badge"/>
                <field name="state" widget="badge"/>
                <button name="action_ack" type="object" string="Prendre en compte" icon="fa-eye" invisible="state != 'new'"/>
                <button name="action_resolve" type="object" string="Résoudre" icon="fa-check" invisible="state == 'resolved'"/>
            </list>
        </field>
    </record>

    <record id="view_adk_alert_form" model="ir.ui.view">
        <field name="name">adk.shop.alert.form</field>
        <field name="model">adk.shop.alert</field>
        <field name="arch" type="xml">
            <form string="Alerte" create="0">
                <header>
                    <button name="action_ack" string="Prendre en compte" type="object" invisible="state != 'new'"/>
                    <button name="action_resolve" string="Marquer résolue" type="object" class="btn-primary" invisible="state == 'resolved'"/>
                    <button name="action_open_source" string="Ouvrir le document" type="object" invisible="not res_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="shop_id"/>
                            <field name="alert_type"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_adk_alert_search" model="ir.ui.view">
        <field name="name">adk.shop.alert.search</field>
        <field name="model">adk.shop.alert</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="shop_id"/>
                <filter string="Ouvertes" name="open" domain="[('state', 'in', ('new', 'ack'))]"/>
                <filter string="Critiques" name="critical" domain="[('severity', '=', '2')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Boutique" name="g_shop" context="{'group_by': 'shop_id'}"/>
                    <filter string="Type" name="g_type" context="{'group_by': 'alert_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_adk_alert" model="ir.actions.act_window">
        <field name="name">Centre d'alertes</field>
        <field name="res_model">adk.shop.alert</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune alerte ouverte</p>
            <p>Les alertes (stock bas, factures en retard, budgets presque consommés) sont générées chaque jour.</p>
        </field>
    </record>
</odoo>
