<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_adk" model="ir.module.category">
        <field name="name">ADK Gestion Boutiques</field>
        <field name="sequence">50</field>
    </record>
    <record id="group_adk_user" model="res.groups">
        <field name="name">Utilisateur boutique</field>
        <field name="category_id" ref="module_category_adk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_adk_manager" model="res.groups">
        <field name="name">Responsable de boutique</field>
        <field name="category_id" ref="module_category_adk"/>
        <field name="implied_ids" eval="[(4, ref('group_adk_user'))]"/>
    </record>
    <record id="group_adk_director" model="res.groups">
        <field name="name">Direction générale</field>
        <field name="category_id" ref="module_category_adk"/>
        <field name="implied_ids" eval="[(4, ref('group_adk_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_adk_restricted" model="res.groups">
        <field name="name">Cloisonné à ses boutiques (documents)</field>
        <field name="category_id" ref="module_category_adk"/>
        <field name="comment">Limite l'accès aux ventes, achats, factures, paiements, mouvements de stock, clients, fournisseurs et produits rattachés aux seules boutiques de l'utilisateur. Les fiches sans boutique restent visibles. À ne pas cumuler avec le rôle Direction générale.</field>
    </record>

    <record id="rule_adk_shop_company" model="ir.rule">
        <field name="name">Boutique : multi-sociétés</field>
        <field name="model_id" ref="model_adk_shop"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_adk_shop_user" model="ir.rule">
        <field name="name">Boutique : mes boutiques</field>
        <field name="model_id" ref="model_adk_shop"/>
        <field name="groups" eval="[(4, ref('group_adk_user'))]"/>
        <field name="domain_force">['|', '|', ('user_ids', 'in', [user.id]), ('manager_id', '=', user.id), ('group_id.manager_id', '=', user.id)]</field>
    </record>
    <record id="rule_adk_shop_director" model="ir.rule">
        <field name="name">Boutique : direction (toutes)</field>
        <field name="model_id" ref="model_adk_shop"/>
        <field name="groups" eval="[(4, ref('group_adk_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
